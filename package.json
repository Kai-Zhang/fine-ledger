{
  "name": "fine-ledger",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build-preview.mjs",
    "iphone:start": "node scripts/iphone-review.mjs start",
    "iphone:status": "node scripts/iphone-review.mjs status",
    "iphone:stop": "node scripts/iphone-review.mjs stop",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json && node --check server.mjs && node --check scripts/build-preview.mjs && node --check scripts/iphone-review.mjs && node --check scripts/service-review.mjs",
    "test": "node --test test/*.test.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json scripts/build-preview.mjs test/domain.test.mjs test/storage.test.mjs",
    "service:start": "node server/main.ts",
    "service:reset-password": "node server/main.ts reset-password",
    "service:restore": "node server/main.ts restore",
    "service:review:start": "node scripts/service-review.mjs start",
    "service:review:status": "node scripts/service-review.mjs status",
    "service:review:stop": "node scripts/service-review.mjs stop",
    "container": "node scripts/container.mjs",
    "container:test": "node scripts/test-service-container.mjs",
    "container:test:tls": "node scripts/test-service-container-tls.mjs"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@js-temporal/polyfill": "0.5.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
